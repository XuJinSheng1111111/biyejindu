# ====================== 1. IDEA / IDE 配置文件 ======================
.idea/
*.iml
*.iws
*.ipr
out/
.apt_generated
.springBeans
.sts-cache

# ====================== 2. Eclipse 相关（兼容） ======================
.classpath
.project
.settings/
bin/
.metadata

# ====================== 3. Maven / Java 编译产物 ======================
target/
build/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ====================== 4. 日志文件 ======================
*.log
logs/
log/
error.log
access.log

# ====================== 5. 私有配置与敏感文件 ======================
# 默认忽略所有 properties 文件，避免真实密码、密钥被提交。
*.properties
# 示例配置必须提交，放在忽略规则之后。
!*.example.properties
!*.example.yml
!*.example.yaml
application.yml
application.yaml
db.config
config.ini
.env
.env.*
!.env.example
.gitee-token
.server-access.json

# ====================== 6. 前端缓存（Vue / Node） ======================
node_modules/
dist/
.cache/
.vite/
.turbo/
.pnpm-store/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ====================== 7. 系统与临时文件 ======================
Thumbs.db
.DS_Store
Desktop.ini
._*
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# ====================== 8. Tomcat 运行缓存 ======================
tomcat/
work/
webapps/ROOT/

# ====================== 9. 压缩包与文档产物 ======================
*.zip
*.rar
*.tar.gz
*.pdf
*.doc
*.docx

# ====================== 10. 本项目的本地材料与工具产物 ======================
# 真实成绩、培养方案和网页导出，仅用于本机回归测试，禁止进入公开仓库。
/源文件/
# Codex 与浏览器自动化生成的备份、截图和状态文件。
/.codex-backups/
/.playwright-cli/
/output/
# 运行时用户上传内容，不属于源码。
/src/main/webapp/upload/
# 发布包只从干净源码重新生成，不提交二进制包。
/release/
/deploy-package/
